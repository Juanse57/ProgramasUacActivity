<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:background="#F9F9F9">

    <ImageView
        android:id="@+id/img_programa"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/img_programa_desc" />

    <TextView
        android:id="@+id/txt_programa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/txt_programa_placeholder"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#111111" />

    <TextView
        android:id="@+id/txt_facultad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/txt_facultad_placeholder"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#0056A6" />

    <TextView
        android:id="@+id/txt_descripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/txt_descripcion_placeholder"
        android:textSize="14sp"
        android:textColor="#444444" />

</LinearLayout>